<view class="container">
  <!-- 页面头部 -->
  <view class="page-header">
    <text class="page-title">{{isEdit ? '编辑商品' : '添加商品'}}</text>
    <text class="page-subtitle">填写商品信息</text>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <view class="input-card">
      <view class="input-label">
        <text class="label-icon">📋</text>
        <text class="label-text">商品类型</text>
      </view>
      <view class="type-options">
        <view class="type-option {{type === item.value ? 'active' : ''}}" wx:for="{{productTypes}}" wx:key="value" data-type="{{item.value}}" bindtap="onTypeChange">{{item.icon}} {{item.label}}</view>
      </view>
    </view>
    <!-- 图片上传 -->
    <view class="upload-card {{imageUrl ? 'has-image' : ''}}" bindtap="chooseImage">
      <image wx:if="{{imageUrl}}" class="preview-image" src="{{imageUrl}}" mode="widthFix"></image>
      <view wx:else class="upload-placeholder">
        <text class="upload-icon">{{typeIcon}}</text>
        <text class="upload-text">添加商品图片（选填）</text>
        <text class="upload-hint">从相册选择或拍照</text>
      </view>
      <!-- 清空图片：有图时显示在右上角 -->
      <view class="clear-image-btn" wx:if="{{imageUrl}}" catchtap="clearImage">
        <text>×</text>
      </view>
    </view>

    <!-- 菜品名称 -->
    <view class="input-card">
      <view class="input-label">
        <text class="label-icon">{{typeIcon}}</text>
        <text class="label-text">商品名称</text>
      </view>
      <input class="input-field" placeholder="{{type === 'membership' ? '例如：芒果 TV 会员' : type === 'gift' ? '例如：鲜花' : '例如：番茄炒蛋'}}" maxlength="20"
             placeholderClass="input-placeholder"
             bindinput="onNameInput" value="{{name}}" />
      <text class="input-counter">{{name.length}}/20</text>
    </view>

    <!-- 菜品分类 -->
    <view class="input-card">
      <view class="input-label">
        <text class="label-icon">📂</text>
        <text class="label-text">商品分类</text>
      </view>
      <picker mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">
          <text>{{categories.length ? categories[categoryIndex].icon + ' ' + categories[categoryIndex].name : '请先在类目管理中添加分类'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="input-card" wx:if="{{type !== 'food'}}">
      <view class="input-label">
        <text class="label-icon">🏷️</text>
        <text class="label-text">规格</text>
        <text class="label-optional">（选填）</text>
      </view>
      <input class="input-field" placeholder="{{type === 'membership' ? '例如：30 天、连续包月' : '例如：一束、粉色、尺寸'}}" placeholderClass="input-placeholder" maxlength="40" bindinput="onSpecInput" value="{{spec}}" />
      <text class="input-counter">{{spec.length}}/40</text>
    </view>

    <!-- 菜品描述 -->
    <view class="input-card">
      <view class="input-label">
        <text class="label-icon">💬</text>
        <text class="label-text">商品描述</text>
        <text class="label-optional">（选填）</text>
      </view>
      <textarea class="description-field" placeholder="填写商品说明或参考链接" placeholder-class="input-placeholder" maxlength="300" auto-height bindinput="onDescInput" value="{{description}}" />
      <text class="input-counter">{{description.length}}/300</text>
    </view>

    <!-- 菜谱（合到一张卡，跟其他字段卡片一致） -->
    <view class="input-card" wx:if="{{type === 'food'}}">
      <view class="input-label">
        <text class="label-icon">📖</text>
        <text class="label-text">菜谱</text>
        <text class="label-optional">（选填）</text>
      </view>

      <view class="recipe-subfield">
        <view class="subfield-label">
          <text class="subfield-icon">🥬</text>
          <text class="subfield-text">食材</text>
          <text class="subfield-hint">每行一项</text>
        </view>
        <textarea class="recipe-textarea" placeholder="例如：鸡蛋 2 个、番茄 1 个、生抽 1 勺"
                  placeholder-class="input-placeholder"
                  style="height: {{ingredientsHeight}}rpx"
                  bindinput="onIngredientsInput" value="{{ingredients}}"
                  disable-default-padding maxlength="-1" />
      </view>

      <view class="recipe-subfield">
        <view class="subfield-label">
          <text class="subfield-icon">👩‍🍳</text>
          <text class="subfield-text">做法</text>
          <text class="subfield-hint">每行一步</text>
        </view>
        <textarea class="recipe-textarea" placeholder="例如：1. 番茄切块 2. 鸡蛋打散 3. 油锅炒蛋"
                  placeholder-class="input-placeholder"
                  style="height: {{stepsHeight}}rpx"
                  bindinput="onStepsInput" value="{{steps}}"
                  disable-default-padding maxlength="-1" />
      </view>

      <view class="recipe-subfield recipe-inline-row">
        <view class="recipe-inline-field">
          <view class="subfield-label">
            <text class="subfield-icon">⏱</text>
            <text class="subfield-text">时长</text>
          </view>
          <picker mode="selector" range="{{cookTimeOptions}}" range-key="label" value="{{cookTimeIndex}}" bindchange="onCookTimeChange">
            <view class="picker-value">
              <text>{{cookTime}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
        <view class="recipe-inline-field">
          <view class="subfield-label">
            <text class="subfield-icon">🌶</text>
            <text class="subfield-text">难度</text>
          </view>
          <picker mode="selector" range="{{difficultyOptions}}" value="{{difficultyIndex}}" bindchange="onDifficultyChange">
            <view class="picker-value">
              <text>{{difficulty}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer">
    <view class="btn-reset" bindtap="resetForm">重置</view>
    <view class="btn-save {{saving || loadingDish ? 'btn-disabled' : ''}}" bindtap="saveDish">{{saving ? '保存中...' : loadingDish ? '加载中...' : isEdit ? '保存修改' : '保存商品'}}</view>
  </view>
</view>
<bind-guard />
