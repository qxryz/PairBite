<view class="container">
  <!-- 页面头部 -->
  <view class="page-header">
    <text class="page-title">订单</text>
    <text class="page-subtitle">查看和{{partnerName}}的订单</text>
  </view>

  <view class="order-filters"><view class="filter-item {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="selectFilter">全部</view><view class="filter-item {{filter === 'mine' ? 'active' : ''}}" data-filter="mine" bindtap="selectFilter">我下的</view><view class="filter-item {{filter === 'received' ? 'active' : ''}}" data-filter="received" bindtap="selectFilter">收到的</view></view>
  <view class="load-error" wx:if="{{loadError}}" bindtap="retryLoad">{{loadError}}</view>
  <view class="load-error" wx:if="{{loading}}">加载中…</view>
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{visibleOrders.length === 0 && !loading && !loadError}}">
    <image class="empty-image" src="/images/a225e0f387212ab7446c87b790a202d3.jpg" mode="aspectFit"></image>
    <text class="empty-title">还没有订单</text>
    <text class="empty-desc">去点单页选择商品或写个心愿</text>
  </view>

  <!-- 历史列表 -->
  <view class="history-list" wx:if="{{visibleOrders.length > 0}}">
    <mp-slideview wx:for="{{visibleOrders}}" wx:key="_id" buttons="{{item.slideButtons}}" data-id="{{item._id}}" data-marked="{{item.marked}}" bindbuttontap="onSlideButtonTap">
      <view class="history-item animate-fadeIn {{item.marked ? 'marked' : ''}}" data-id="{{item._id}}" bindtap="goToDetail">
        <view class="history-header">
          <view class="history-date">
            <text class="date-icon">📅</text>
            <text class="date-text">{{item.dateText}}</text>
          </view>
          <view class="history-state"><text class="demo-badge" wx:if="{{item.isDemo}}">{{item.isSample ? '示例' : '体验'}}</text><text class="status-badge {{item.status}}">{{item.statusText}}</text><text class="history-time">{{item.timeText}}</text></view>
        </view>
        <view class="history-dishes">
          <view class="history-dish" wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="_id">
            <image class="history-dish-image" wx:if="{{!dish.imageUrl}}" src="/images/a225e0f387212ab7446c87b790a202d3.jpg" mode="aspectFill"></image>
            <image class="history-dish-image" wx:if="{{dish.imageUrl}}" src="{{dish.imageUrl}}" mode="aspectFill"></image>
            <text class="history-dish-name">{{dish.name}}</text>
          </view>
        </view>
        <view class="history-wish" wx:if="{{item.wish}}"><text>💝 {{item.wish.title}}</text></view>
        <view class="history-expected" wx:if="{{item.expectedDate}}">希望日期：{{item.expectedDate}}</view>
        <view class="history-remark" wx:if="{{item.remark}}">
          <text class="remark-icon">💬</text>
          <text class="remark-text">{{item.remark}}</text>
        </view>
        <view class="history-footer">
          <text class="history-creator">{{item.creatorName}}下的订单</text>
          <text class="dish-count">{{item.wish ? '心愿订单' : '共 ' + item.dishes.length + ' 件'}}</text>
        </view>
      </view>
    </mp-slideview>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && !loading && !loadError}}" bindtap="loadMore">
    <text>加载更多</text>
  </view>

  <!-- 没有更多了 -->
  <view class="no-more" wx:if="{{visibleOrders.length > 0 && !hasMore}}">
    <text>~ 已经到底啦 ~</text>
  </view>

  <!-- 提示弹窗 -->
  <view class="tip-modal" wx:if="{{showTipModal}}" bindtap="closeTipModal">
    <view class="tip-content" catchtap="preventClose">
      <image class="tip-image" src="/images/7b4bee27a7ccb84274ec7753e54c50c7.gif" mode="aspectFit"></image>
      <text class="tip-text">{{tipText}}</text>
      <view class="tip-btn" bindtap="closeTipModal">知道啦~</view>
    </view>
  </view>
</view>

<bind-guard />
